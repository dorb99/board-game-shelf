# Which AI service looks games up and answers rules questions: gemini or openai
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that supports Google Search grounding
GEMINI_MODEL=gemini-flash-latest

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any OpenAI model that supports the web search tool
OPENAI_MODEL=gpt-5-mini
# Reasoning effort for OpenAI reasoning models (low keeps lookups fast and cheap);
# leave blank for a model that does not take this setting
OPENAI_REASONING_EFFORT=low
# Where the SQLite database and downloaded covers live (default: backend/data)
# DATA_DIR=
